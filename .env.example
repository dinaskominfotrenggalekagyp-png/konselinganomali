# Salin file ini menjadi `.env` lalu isi nilainya.
#   Copy-Item .env.example .env

# --- Database ---
# MySQL/MariaDB (XAMPP)
DATABASE_URL="mysql://root:@127.0.0.1:3306/koseling_tgx"

# --- Auth ---
AUTH_SECRET="ganti-dengan-string-acak-panjang"

# --- Integrations (opsional, otomatis fallback ke mode simulasi) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PAYMENT_PROVIDER="mock"          # mock | midtrans
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# --- Email admin / transaksional ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
EMAIL_FROM="Konseling Trenggalek <no-reply@example.com>"

# Tujuan notifikasi admin
ADMIN_EMAIL=""
ADMIN_WHATSAPP=""

# --- WhatsApp ---
WHATSAPP_NUMBER=""
FONNTE_TOKEN=""
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_CLOUD_PHONE_ID=""
CALLMEBOT_API_KEY=""

GOOGLE_MAPS_EMBED=""
