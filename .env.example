# Salin file ini menjadi `.env` lalu isi nilainya.
#   Copy-Item .env.example .env

# --- Database (Supabase / PostgreSQL) ---
# Ambil dari Supabase Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL: Connection Pooling (port 6543). Dipakai runtime aplikasi & Vercel.
#   Wajib tambahkan ?pgbouncer=true&connection_limit=1 untuk serverless.
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# DIRECT_URL: Direct connection (port 5432). Hanya untuk prisma migrate / db push / seed.
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"
#
# Khusus proses migrasi data dari MySQL lokal (dipakai skrip migrate-mysql-to-supabase).
MYSQL_SOURCE_URL="mysql://root:@127.0.0.1:3306/koseling_tgx"

# --- Auth ---
AUTH_SECRET="ganti-dengan-string-acak-panjang"

# --- Integrations (opsional, otomatis fallback ke mode simulasi) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PAYMENT_PROVIDER="mock"          # mock | midtrans
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# --- Email admin / transaksional ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
EMAIL_FROM="Konseling Trenggalek <no-reply@example.com>"

# Tujuan notifikasi admin
ADMIN_EMAIL=""
ADMIN_WHATSAPP=""

# --- WhatsApp ---
WHATSAPP_NUMBER=""
FONNTE_TOKEN=""
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_CLOUD_PHONE_ID=""
CALLMEBOT_API_KEY=""

GOOGLE_MAPS_EMBED=""
