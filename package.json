{
  "name": "konseling-trenggalek",
  "version": "1.0.0",
  "private": true,
  "description": "Platform asesmen psikologi & kesehatan mental - fullstack Next.js + Prisma + MySQL (XAMPP)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:accounts": "node prisma/ensure-accounts.mjs",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:migrate:sqlite": "node prisma/migrate-sqlite-to-mysql.mjs",
    "db:rebrand": "node prisma/rebrand-existing.mjs",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.545.0",
    "next": "15.5.28",
    "nodemailer": "^10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
